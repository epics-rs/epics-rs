rec0: SR830.proto snap(1,2,3,4,5,6,7,8,9) P
snap {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "SNAP?1,2,3,4,9";
    in "%(1:X.VAL)f,%(1:Y.VAL)f,%(1:R.VAL)f,%(1:TH.VAL)f,%(1:REF.VAL)f";
}
rec1: SR830.proto snap_aux(1,2,3,4,5,6,7,8,9) P
