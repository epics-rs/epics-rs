rec0: NeslabEX.proto get_temp(1,2,3,4,5,6,7,8,9) P
get_temp {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "\xca\x00\x01\x20\x00\xde";
    in "%*6r%2r%*r";
}
rec1: NeslabEX.proto get_sp(1,2,3,4,5,6,7,8,9) P
