rec0: JenaNV40.proto readError(1,2,3,4,5,6,7,8,9) P
readError {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r\n";
  outTerminator = "\r";
  separator     = "";

    out "err";
    in "err,%s";
}
