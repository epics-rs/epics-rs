rec0: Synaccess_netBooter.proto reboot(1,2,3,4,5,6,7,8,9) P
reboot {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "\r\n";
  separator     = "";

    out "$A4 1";
    in "%*s";
}
rec1: Synaccess_netBooter.proto setall(1,2,3,4,5,6,7,8,9) P
