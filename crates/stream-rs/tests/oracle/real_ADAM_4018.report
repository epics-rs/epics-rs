rec5: ADAM_4018.proto setInput(1,2,3,4,5,6,7,8,9) P
setInput {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "\x2511%{00|01|02|03|04|05|06|0E|0F|10|11|12|13|14}%(2:baud){03|04|05|06|07|08}00";
}
