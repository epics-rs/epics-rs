rec16: example.proto char_wave_in(1,2,3,4,5,6,7,8,9) P
char_wave_in {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 1000; # ms
  replyTimeout  = 10000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 10000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r\n";
  outTerminator = "";
  separator     = "";

    out "\x0d\x0aEnter String: ";
    in "%1000c";
    out "Got: \"%s\"\x0d\x0a";
}
