# Regression IOC database.
#
# Each record block exists to pin a recurring bug-fix behavior observed across
# v0.15.x-v0.20.x. The companion e2e tests boot this db under real CA+PVA
# servers and assert the FIXED behavior over the wire, so a future regression
# in the same family fails the test rather than silently shipping.
#
# Naming: REG:<family>:<role>
#   A = processing-chain ordering (OUT/FLNK/DOL/PUTF)
#   B = monitor / DBE event posting (post-only-on-change)
#   C = SCAN / process gating (periodic scan runs while a server is up)
#   E = enum / DBF_MENU -> DBR_ENUM (choice labels, caput-by-label)
#   F = field typing (raw/index fields keep their integer DBF type)
#   G = alarm / SEVR / STAT (severity raised on limit violation)
#   H = timestamp (advances on each process, nsec WallTime)
#   I = monitor event-MASK routing (MDEL/ADEL -> DBE_VALUE/DBE_LOG class)
# Families D (motor) and the motor SCAN=Passive regression live in db sections
# added with their device support; asyn records likewise.

#### Family A — processing-chain ordering ####################################
# caput to A:SRC must walk its FLNK to A:SINK, which reads SRC fresh through a
# DB input link. Pins "FLNK chain runs on a caput to a Passive record" and the
# OUT-before-FLNK / processTarget family.
record(longout, "REG:A:SRC") {
    field(DESC, "FLNK chain source")
    field(VAL,  "0")
    field(FLNK, "REG:A:SINK")
}
record(calc, "REG:A:SINK") {
    field(DESC, "FLNK chain sink")
    field(SCAN, "Passive")
    field(INPA, "REG:A:SRC")
    field(CALC, "A")
}
# calcout OUT-link leg: caput to CO.A processes CO, whose result is written
# through a PP OUT link to A:OTGT. Pins "OUT-link write happens on process".
record(calcout, "REG:A:CO") {
    field(DESC, "OUT-link source")
    field(SCAN, "Passive")
    field(CALC, "A+1")
    field(OUT,  "REG:A:OTGT PP")
}
record(longout, "REG:A:OTGT") {
    field(DESC, "OUT-link target")
    field(VAL,  "0")
}

#### Family B — monitor posts only on change ################################
record(bo, "REG:B:BO") {
    field(DESC, "monitor on-change")
    field(ZNAM, "Lo")
    field(ONAM, "Hi")
    field(VAL,  "0")
}

#### Family C — periodic SCAN runs while a server is up #####################
record(longout, "REG:C:SRC") {
    field(DESC, "periodic-scan source")
    field(VAL,  "0")
}
record(calc, "REG:C:SCAN") {
    field(DESC, "1-second scanned mirror")
    field(SCAN, "1 second")
    field(INPA, "REG:C:SRC")
    field(CALC, "A")
}

#### Family E — enum / DBF_MENU -> DBR_ENUM #################################
record(mbbo, "REG:E:MBBO") {
    field(DESC, "enum choice + caput-by-label")
    field(ZRST, "Off")
    field(ONST, "On")
    field(TWST, "Standby")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(VAL,  "0")
}

#### Family F — field typing (covered via REG:E:MBBO.RVAL integer type) #####
# (no extra record; the F assertion reads REG:E:MBBO.RVAL's DBF type)

#### Family G — alarm severity raised on limit violation ####################
record(ai, "REG:G:AI") {
    field(DESC, "alarm-limit severity")
    field(VAL,  "50")
    field(PINI, "YES")
    field(HIHI, "90")
    field(HIGH, "80")
    field(LOW,  "20")
    field(LOLO, "10")
    field(HHSV, "MAJOR")
    field(HSV,  "MINOR")
    field(LSV,  "MINOR")
    field(LLSV, "MAJOR")
    field(HYST, "0")
}

#### Family H — timestamp advances on each process #########################
record(ai, "REG:H:AI") {
    field(DESC, "timestamp advance")
    field(VAL,  "0")
}

#### Family I — monitor event-MASK routing (MDEL/ADEL -> DBE class) #########
# Pins the per-field monitor event-MASK contract: which DBE class a field
# posts, and that a subscriber filtering by an explicit DBE_* mask gets exactly
# the posts whose class intersects it. With MDEL=10/ADEL=0, a sub-MDEL VAL
# change crosses ADEL but not MDEL, so it posts DBE_LOG only — a DBE_VALUE-only
# subscriber must NOT see it while a DBE_LOG subscriber must; a supra-MDEL
# change posts DBE_VALUE|DBE_LOG and reaches both. This is the family behind the
# motor force-post, the scaler idle-LOG sweep, and the scaler value-only change;
# Family B (post-only-on-change) does not exercise the DBE class of the post.
record(ai, "REG:I:AI") {
    field(DESC, "deadband event-mask routing")
    field(VAL,  "0")
    field(MDEL, "10")
    field(ADEL, "0")
}

#### Family K — .PROC write forces a process; put-callback waits ###########
# A caput to REC.PROC with value 0 must force a process (it was once a silent
# no-op for 0), and a put-with-callback (CA WRITE_NOTIFY) must return only after
# processing completes. K:CALC mirrors K:SRC through INPA; after seeding SRC and
# forcing K:CALC.PROC=0, an IMMEDIATE caget of K:CALC must already equal SRC
# (no poll) — proving both the forced process and put-callback completion.
record(longout, "REG:K:SRC") {
    field(DESC, "proc-force source")
    field(VAL,  "0")
}
record(calc, "REG:K:CALC") {
    field(DESC, "proc-force / put-callback")
    field(SCAN, "Passive")
    field(INPA, "REG:K:SRC")
    field(CALC, "A")
}

#### Family N — MS-class link propagates alarm severity ####################
# A reader whose input link carries the MS (maximize-severity) modifier must
# inherit the SOURCE record's severity (recGblInheritSevrMsg), not just its
# value. When N:SRC violates HIHI and goes MAJOR, processing N:READER folds its
# MS input link and raises READER to MAJOR even though READER has no limits of
# its own; clearing SRC drops READER back to NO_ALARM. Distinct from Family G,
# which raises severity from the record's OWN limit violation. (The test forces
# READER with a .PROC write so the pin does not depend on CP auto-reprocessing,
# which the lightweight IocBuilder boot path does not wire.)
record(ai, "REG:N:SRC") {
    field(DESC, "MS-link severity source")
    field(VAL,  "0")
    field(HIHI, "90")
    field(HHSV, "MAJOR")
    field(HYST, "0")
}
record(calc, "REG:N:READER") {
    field(DESC, "MS-link severity reader")
    field(SCAN, "Passive")
    field(INPA, "REG:N:SRC MS")
    field(CALC, "A")
}

#### Family J — DBR_STRING byte-faithful round-trip ########################
# A stringout VAL must round-trip a full-width (39-char) DBR_STRING over CA
# byte-for-byte — no truncation, no reordering, no mangling. Pins the
# string-fidelity family. (The non-UTF8 byte and `$` long-string paths are
# CLI-scoped — the library client puts strings as &str — so they are covered by
# caget-rs/caput-rs tests, not this in-process harness; see the Family E note.)
record(stringout, "REG:J:SO") {
    field(DESC, "string round-trip")
    field(VAL,  "seed")
}

#### Family M — DBE_PROPERTY posts on a metadata-field change ##############
# Writing a metadata/property field (here HOPR) must post a DBE_PROPERTY event
# to a camonitor that subscribed with DBE_PROPERTY, so a client's cached
# display/control metadata stays fresh — while a DBE_VALUE-only subscriber must
# NOT see it (a property change is not a value change). Sibling of Family I's
# per-field DBE-class routing, on the DBE_PROPERTY axis.
record(ai, "REG:M:AI") {
    field(DESC, "DBE_PROPERTY metadata change")
    field(VAL,  "1")
    field(EGU,  "V")
    field(HOPR, "100")
    field(LOPR, "0")
    field(PREC, "2")
}

#### Family O — seeded record suppresses a duplicate first-cycle post ######
# An integer record seeded nonzero (here VAL=7, PINI) must NOT post a spurious
# duplicate VAL monitor when it processes an UNCHANGED value: C seeds MLST/ALST
# to VAL at init, so the first/idempotent process detects "no change". With
# MDEL=0 a real change still posts. Distinct from Family B, which suppresses a
# no-op caput (write-path no-change) — this is the PROCESS-path no-change on a
# seeded longin/longout/int64 (the recurring MLST/ALST-sentinel family).
record(longout, "REG:O:LO") {
    field(DESC, "first-cycle / idempotent suppression")
    field(VAL,  "7")
    field(PINI, "YES")
    field(MDEL, "0")
}

#### Family D — motor record moves on a caput to VAL (SCAN=Passive) #########
# The v0.20.0 regression: a caput to a SCAN=Passive motor's VAL did not move
# it (the I/O-Intr-vs-Passive dbPutField processing gate). Pins "caput to a
# Passive motor VAL actually drives the move; RBV converges, DMOV cycles".
# Device support (sim driver + poll loop) is supplied by the harness, keyed on
# DTYP "simMotor".
record(motor, "REG:D:MTR") {
    field(DESC, "sim motor move-on-caput")
    field(DTYP, "simMotor")
    field(SCAN, "Passive")
    field(VELO, "20.0")
    field(ACCL, "0.2")
    field(MRES, "0.01")
    field(DHLM, "100.0")
    field(DLLM, "-100.0")
    field(PREC, "3")
}
