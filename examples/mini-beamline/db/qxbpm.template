# Quad X-ray BPM — asyn port surface for simQxbpmCreate().
#
# Record names follow optics' qxbpm.db so a display built for the real
# module finds them; the SNL program there is replaced by the QxbpmDriver
# parameter list, so only the parameters the driver implements appear.
#
# Macros: P, PORT

# --- Beam position (driver computes it from the four diode currents) ---

record(ai, "$(P)pos:x") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))X_POS")
    field(SCAN, "I/O Intr")
    field(PREC, "4")
    field(EGU,  "mm")
}

record(ai, "$(P)pos:y") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))Y_POS")
    field(SCAN, "I/O Intr")
    field(PREC, "4")
    field(EGU,  "mm")
}

