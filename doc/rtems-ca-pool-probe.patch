+/// MEASUREMENT ONLY (doc/rtems-ca-pool-probe.patch) — the RTEMS task census
+/// on stdout, one `TASKDUMP` line per thread.
+///
+/// The listing is the only instrument that sees a pooled worker: pthread names
+/// are invisible to `rtems_object_get_name` (they come back blank in `obj=`),
+/// and `_Thread_Get_name` — the `thread=` column — is what carries them.
+#[cfg(all(target_os = "rtems", rtems_boot_linked))]
+pub fn dump_tasks(tag: &str) {
+    let c = std::ffi::CString::new(tag).unwrap_or_default();
+    // SAFETY: `c` outlives the call and the C side only reads the string.
+    unsafe { ffi::epics_rtems_boot_dump_tasks(c.as_ptr()) };
+}
+
+/// Host builds have no boot shim, so there is no listing to take.
+#[cfg(not(all(target_os = "rtems", rtems_boot_linked)))]
+pub fn dump_tasks(_tag: &str) {}
