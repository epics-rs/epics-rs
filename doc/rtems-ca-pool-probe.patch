+/// MEASUREMENT ONLY — read the band back off the OS scheduler and print it.
+///
+/// `apply_to_current_thread` reports what it *asked* for; this reports what
+/// the kernel actually holds, which is the only thing a band claim can be
+/// checked against.
+#[cfg(target_os = "rtems")]
+fn rtems_priority_readback(label: &str, requested_epics: i32, applied: &str) {
+    let mut policy: std::ffi::c_int = -1;
+    let mut param = rtems_sched::SchedParam {
+        sched_priority: -1,
+        sporadic_tail: [0u8; 44],
+    };
+    // SAFETY: both out-parameters are live locals of exactly the width the
+    // target's header declares (the `SchedParam` size assertion above).
+    let rc = unsafe {
+        rtems_sched::pthread_getschedparam(rtems_sched::pthread_self(), &mut policy, &mut param)
+    };
+    let posix = param.sched_priority;
+    println!(
+        "PRIOPROBE label={label} epics={requested_epics} applied={applied} \
+         getsched_rc={rc} policy={policy} posix={posix} core={}",
+        255 - posix
+    );
 }
 
