# XIA HSC-1 slit controller — asyn port surface for simHscCreate().
#
# Record names follow optics' xiahsc.db so a display built for the real
# module finds them; the SNL program there is replaced by the HscDriver
# parameter list, so only the parameters the driver implements appear.
#
# Macros: P, HSC, PORT

# --- Gap/center setpoints (writing either moves both blades of that axis) ---

record(ao, "$(P)$(HSC)width") {
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))H_GAP")
    field(PREC, "4")
    field(EGU,  "mm")
}

record(ai, "$(P)$(HSC)widthRB") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))H_GAP_RBV")
    field(SCAN, "I/O Intr")
    field(PREC, "4")
    field(EGU,  "mm")
}

