rec0: ADAM_4015.proto queryAll(1,2,3,4,5,6,7,8,9) P
queryAll {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 1000; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "#1";
    in ">%(2:all_rtd0)f%(2:all_rtd1)f%(2:all_rtd2)f%(2:all_rtd3)f%(2:all_rtd4)f%(2:all_rtd5)f";
}
rec1: ADAM_4015.proto queryChan(1,2,3,4,5,6,7,8,9) P
