rec0: KeyenceCL3000.proto emission_ctrl(1,2,3,4,5,6,7,8,9) P
emission_ctrl {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";
  @Mismatch {
    in "%(1:errorString)s";
  }

    out "LC,%i";
    in "LC";
}
