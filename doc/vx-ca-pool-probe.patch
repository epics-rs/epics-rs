+/// BRING-UP PROBE (`doc/vx-ca-pool-probe.patch`): the CA client pool's
+/// `(busy_sets, created_sets, capacity, workers)`, for `realtime-ca-ioc`'s
+/// console reporter.
+///
+/// [`CAS_CLIENT_POOL`] is private and a bin target is a separate crate, so the
+/// rig gets one accessor rather than the static. `created_sets` is the number
+/// the bound is *about* — thread creations, which is what the per-accept shape
+/// grew without limit — and `busy_sets` is what is leased right now, so a flat
+/// `created` under a rising `busy` is the whole statement.
+#[cfg(feature = "bringup-probes")]
+pub fn client_pool_probe() -> (usize, usize, usize, usize) {
+    let (busy, created, capacity) = CAS_CLIENT_POOL.set_usage();
+    (busy, created, capacity, CAS_CLIENT_POOL.worker_count())
+}
