rec0: Tabor8024.proto getString(1,2,3,4,5,6,7,8,9) P
getString {
  extraInput    = error;
  lockTimeout   = 30000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 3000; # ms
  writeTimeout  = 3000; # ms
  pollPeriod    = 3000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "1?";
    in "%s";
}
