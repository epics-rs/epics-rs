rec0: NCD_R2X.proto relay1query(1,2,3,4,5,6,7,8,9) P
relay1query {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "\r";
  separator     = "";
  @Mismatch {
    out "\xfe\x04";
    in "%#{\x00=0|\x01=1}";
  }

    out "\xfe\x04";
    in "%#{\x00=0|\x01=1}";
}
