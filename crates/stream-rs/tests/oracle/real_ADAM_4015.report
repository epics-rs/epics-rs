  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "$12";
    in "!1%*2s%{03|04|05|06|07|08}%*2s";
}
