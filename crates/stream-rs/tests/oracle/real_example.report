rec0: example.proto binary(1,2,3,4,5,6,7,8,9) P
binary {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 1000; # ms
  replyTimeout  = 10000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 10000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r\n";
  outTerminator = "\r\n";
  separator     = "";

    out "%B\x00\xff";
}
