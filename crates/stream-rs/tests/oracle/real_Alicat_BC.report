rec0: Alicat_BC.proto setGas(1,2,3,4,5,6,7,8,9) P
setGas {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";
  @Init {
    out "1 GS";
    in "1 %d";
  }

    out "1 GS %d";
    in "1";
}
