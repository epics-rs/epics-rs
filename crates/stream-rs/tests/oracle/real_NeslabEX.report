rec3: NeslabEX.proto set_temp(1,2,3,4,5,6,7,8,9) P
set_temp {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "\xca";
    out "\x00\x03\xf0\x02%.2r%<~sum>";
}
