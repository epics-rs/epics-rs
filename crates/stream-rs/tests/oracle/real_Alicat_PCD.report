rec0: Alicat_PCD.proto getUnits(1,2,3,4,5,6,7,8,9) P
getUnits {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "1 DCU 6";
    in "1 %d";
}
