rec0: SRS_SG390.proto getIdString(1,2,3,4,5,6,7,8,9) P
getIdString {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 500; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r\n";
  outTerminator = "\n";
  separator     = "";

    out "*IDN?";
    in "%120c";
}
