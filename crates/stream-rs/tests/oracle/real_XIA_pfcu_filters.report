rec0: XIA_pfcu_filters.proto setMode(1,2,3,4,5,6,7,8,9) P
setMode {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 500; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "!PFCU1 {4|2}";
    in "\x25PFCU1 OK Shutter Mode %{Disabled|Enabled} DONE\x3b";
}
