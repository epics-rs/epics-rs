rec0: teled_h.proto ping(1,2,3,4,5,6,7,8,9) P
ping {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "\x0d1R %0<nsum>";
    in "R %0<nsum>";
}
