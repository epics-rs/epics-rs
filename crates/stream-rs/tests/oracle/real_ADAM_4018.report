rec3: ADAM_4018.proto queryInput(1,2,3,4,5,6,7,8,9) P
queryInput {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "$12";
    in "!1%{00|01|02|03|04|05|06|0E|0F|10|11|12|13|14}%*2s%*2s";
}
rec4: ADAM_4018.proto queryBaud(1,2,3,4,5,6,7,8,9) P
