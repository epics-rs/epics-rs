rec0: caen_N8031.proto read_voltages(1,2,3,4,5,6,7,8,9) P
read_voltages {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r\n";
  outTerminator = "\r\n";
  separator     = "";

    out "$CMD:MON,CH:8,PAR:VMON";
    in "#CMD:OK,VAL:%(1CH0:Voltage_RBV)f;%(1CH1:Voltage_RBV)f;%(1CH2:Voltage_RBV)f;%(1CH3:Voltage_RBV)f;%(1CH4:Voltage_RBV)f;%(1CH5:Voltage_RBV)f;%(1CH6:Voltage_RBV)f;%(1CH7:Voltage_RBV)f";
}
