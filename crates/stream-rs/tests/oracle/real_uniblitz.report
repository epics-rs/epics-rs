rec0: uniblitz.proto checkSync(1,2,3,4,5,6,7,8,9) P
checkSync {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\n";
  outTerminator = "\n";
  separator     = "";

    out "?";
    in "%{K|J}";
}
rec1: uniblitz.proto setShutter(1,2,3,4,5,6,7,8,9) P
setShutter {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\n";
  outTerminator = "\n";
  separator     = "";
  @Init {
    out "?";
    in "%{K|J}";
  }

    out "%{A|@}";
}
