rec0: PHD2000.proto getString(1,2,3,4,5,6,7,8,9) P
getString {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 3000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 500; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "\r";
  separator     = "";

    out "1";
    in "\x0a%[ A-Z]\x0d\x0a%*[><:/*^]";
}
