rec0: simple.proto cmd(1,2,3,4,5,6,7,8,9) P
cmd {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\n";
  outTerminator = "\n";
  separator     = "";

    out "%s";
}
rec1: simple.proto info(1,2,3,4,5,6,7,8,9) P
info {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\n";
  outTerminator = "\n";
  separator     = "";

    out "%s";
    in "%39c";
}
rec2: simple.proto read(1,2,3,4,5,6,7,8,9) P
read {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\n";
  outTerminator = "\n";
  separator     = "";

    in "%39c";
}
