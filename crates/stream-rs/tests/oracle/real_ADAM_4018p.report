rec0: ADAM_4018p.proto queryAll(1,2,3,4,5,6,7,8,9) P
queryAll {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 1000; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "#1";
    in ">%(2:all_tc0)f%(2:all_tc1)f%(2:all_tc2)f%(2:all_tc3)f%(2:all_tc4)f%(2:all_tc5)f%(2:all_tc6)f%(2:all_tc7)f";
}
