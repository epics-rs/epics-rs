rec0: BK9130.proto getIDN(1,2,3,4,5,6,7,8,9) P
getIDN {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";
  @Init {
    out "*IDN?";
    in "%s";
  }

    out "*IDN?";
    in "%s";
}
