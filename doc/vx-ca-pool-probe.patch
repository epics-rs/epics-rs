+/// MEASUREMENT ONLY — read the band back off the OS scheduler and print it.
+///
+/// [`apply_to_current_thread`] reports what it *asked* for; this reports what
+/// the kernel actually holds, which is the only thing a band claim can be
+/// checked against. Three legs, where RTEMS's counterpart had two:
+///
+/// * `posix=` — `pthread_getschedparam`, the POSIX value this port sets;
+/// * `vx=` — `taskPriorityGet` on the calling task, the **native** value
+///   VxWorks derived from it. RTEMS's second leg was `rtems_task_iterate` from
+///   outside the thread; here the native reading is available on the thread
+///   itself, so both legs describe the same task with no id mapping in between;
+/// * and the census's `prio=` (`taskInfoGet`, `stats::dump_tasks`) is a third,
+///   taken later from a different API — which needs no patch at all.
+///
+/// `expect_posix`/`expect_vx` are printed rather than asserted so a mismatch is
+/// a reading, not a crashed IOC.
+#[cfg(target_os = "vxworks")]
+fn vx_priority_readback(label: &str, requested_epics: i32, applied: &str) {
+    let mut policy: std::ffi::c_int = -1;
+    // SAFETY: `pthread_getschedparam` acts on the calling thread and writes
+    // only into the two live locals given, both of `libc`'s own VxWorks width.
+    let (rc, posix) = unsafe {
+        let mut param: libc::sched_param = std::mem::zeroed();
+        let rc = libc::pthread_getschedparam(libc::pthread_self(), &mut policy, &mut param);
+        (rc, param.sched_priority)
+    };
+    let mut vx: std::ffi::c_int = -1;
+    // SAFETY: `taskIdSelf` names the calling task and `taskPriorityGet` writes
+    // only into the live `c_int` given. Both are `T`-defined in the RTP-side
+    // `libc.a` (measured with `nmpentium`, per this port's rule that a symbol is
+    // declared only once it has been seen defined).
+    let vx_rc = unsafe { vx_sched::taskPriorityGet(libc::taskIdSelf(), &mut vx) };
+    println!(
+        "PRIOPROBE label={label} epics={requested_epics} applied={applied} \
+         getsched_rc={rc} policy={policy} posix={posix} taskprio_rc={vx_rc} vx={vx} \
+         expect_posix={} expect_vx={}",
+        56 + requested_epics.min(99),
+        199 - requested_epics.min(99)
+    );
+}
+
+/// MEASUREMENT ONLY — the one scheduler symbol this probe needs that `libc`
+/// does not declare for VxWorks.
+///
+/// `libc` binds `taskIdSelf`, `taskNameGet`/`Set`, `pthread_getschedparam` and
+/// `pthread_setschedparam`, but none of `taskPriorityGet`, `taskPrioritySet`,
+/// `taskIdListGet` or `taskInfoGet`. Of those, `taskIdListGet` is kernel-only
+/// and absent from every RTP library — which is why the statistics funnel's
+/// census is a registry rather than an enumeration — but `taskPriorityGet`
+/// **is** defined in the RTP-side `libc.a`, so the native band is readable from
+/// inside an RTP after all.
+///
+/// `TASK_ID` is `OBJ_HANDLE` is `int`, the same 4-byte spelling
+/// `stats::vxworks` pins for `taskInfoGet`; `libc::taskIdSelf` is reused rather
+/// than redeclared so the two cannot disagree about it.
+#[cfg(target_os = "vxworks")]
+mod vx_sched {
+    use std::ffi::c_int;
+
+    unsafe extern "C" {
+        /// `taskLib.h`: `STATUS taskPriorityGet (TASK_ID tid, int * pPriority)`.
+        pub fn taskPriorityGet(tid: c_int, p_priority: *mut c_int) -> c_int;
+    }
 }
 
