rec0: Metis_M322.proto getErrorStatus(1,2,3,4,5,6,7,8,9) P
getErrorStatus {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 500; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "1fs";
    in "%02d";
}
