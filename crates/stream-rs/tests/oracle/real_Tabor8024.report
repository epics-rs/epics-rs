  separator     = "";

    out ":TRAC:DATA #0%.2r\x0a";
}
rec8: Tabor8024.proto setUserWfSize(1,2,3,4,5,6,7,8,9) P
setUserWfSize {
  extraInput    = error;
  lockTimeout   = 30000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 3000; # ms
  writeTimeout  = 5000; # ms
  pollPeriod    = 3000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out ":TRAC:DEL 1";
    out ":TRAC:DEF 1,%d";
}
rec9: Tabor8024.proto getError(1,2,3,4,5,6,7,8,9) P
getError {
  extraInput    = error;
  lockTimeout   = 30000; # ms
