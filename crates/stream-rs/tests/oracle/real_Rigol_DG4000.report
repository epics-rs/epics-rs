rec0: Rigol_DG4000.proto getLongString(1,2,3,4,5,6,7,8,9) P
getLongString {
  extraInput    = error;
  lockTimeout   = 3000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 1000; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "1?";
    in "%#s";
}
