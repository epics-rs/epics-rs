rec8: teled_d.proto setPress(1,2,3,4,5,6,7,8,9) P
setPress {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";
  @Init {
    out "1R009SETPRESS2%0<nsum>";
    in "R0\?\?PRESS2=%f %0<nsum>";
  }

    out "1R00FPRESS2=%08.4f%0<nsum>";
    in "R %0<nsum>";
}
