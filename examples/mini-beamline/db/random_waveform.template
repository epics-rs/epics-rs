# 10000-element double waveform for bulk-transfer benchmarks.
# Populated at IOC init, then refreshed once per second by device support.
#
# Macros:
#   P    record prefix (e.g. "mini:wf")
#   N    record suffix (e.g. "1" → "mini:wf1")
#   NELM array length (default 10000)
record(waveform, "$(P)$(N)") {
    field(DTYP, "miniRandomWaveform")
    field(NELM, "$(NELM=10000)")
    field(FTVL, "DOUBLE")
    field(SCAN, "1 second")
    field(PINI, "YES")
}
