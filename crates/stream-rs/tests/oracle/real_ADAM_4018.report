rec0: ADAM_4018.proto queryAll(1,2,3,4,5,6,7,8,9) P
queryAll {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "#1";
    in ">%(2:ai0)f%(2:ai1)f%(2:ai2)f%(2:ai3)f%(2:ai4)f%(2:ai5)f%(2:ai6)f%(2:ai7)f";
}
