rec0: Oxford_CryoJet.proto getSetpointTemp(1,2,3,4,5,6,7,8,9) P
getSetpointTemp {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";
  @Mismatch {
    in "?\?";
  }

    out "R0";
    in "R%f";
}
