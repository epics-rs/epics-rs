rec0: capaNCDT6200.proto grabWelcomeText(1,2,3,4,5,6,7,8,9) P
grabWelcomeText {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r\n";
  outTerminator = "\r";
  separator     = "";

    in "%1[^\x0d\x0a]";
}
rec1: capaNCDT6200.proto queryVer(1,2,3,4,5,6,7,8,9) P
queryVer {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r\n";
  outTerminator = "\r";
  separator     = "";

    out "$VER";
    in "$VER%(1:version1M.VAL)[^;];%(1:version2M.VAL)[^OK]OK";
}
