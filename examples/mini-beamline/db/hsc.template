# --- Status ---

# One BUSY parameter covers both axes; the driver reports any blade moving.
record(bi, "$(P)$(HSC)busy") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))BUSY")
    field(SCAN, "I/O Intr")
    field(ZNAM, "Done")
    field(ONAM, "Moving")
}

record(longout, "$(P)$(HSC)power") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))POWER_LEVEL")
    field(DRVL, "0")
    field(DRVH, "2")
}

record(longin, "$(P)$(HSC)powerRB") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))POWER_LEVEL")
    field(SCAN, "I/O Intr")
}
