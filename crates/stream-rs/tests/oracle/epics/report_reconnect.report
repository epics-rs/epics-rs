rec: l.proto r P
active command=none flags=0x20004a InitRun GotValue ScanTried
r {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r\n";
  outTerminator = "\r\n";
  separator     = "";
  @Init {
    out "I";
    in "%d";
  }

    out "GET";
    in "%d";
}

