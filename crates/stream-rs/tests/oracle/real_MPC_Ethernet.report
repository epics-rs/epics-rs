rec7: MPC_Ethernet.proto readAutoRestart(1,2,3,4,5,6,7,8,9) P
readAutoRestart {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 2000; # ms
  writeTimeout  = 1000; # ms
  pollPeriod    = 2000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "cmd 34 1";
    in "OK 00 %{NO|YES}";
}
rec8: MPC_Ethernet.proto writeAutoRestart(1,2,3,4,5,6,7,8,9) P
