+/// MEASUREMENT ONLY — §8.0 gap 2 of `doc/rtems-scope-b-session-handoff.md`.
+///
+/// Read the calling thread's scheduling parameters **back from the kernel**
+/// and print them on the console. Deliberately not derived from what
+/// `pthread_setschedparam` returned: a return code says the call was
+/// accepted, an effective priority says what the scheduler will actually
+/// use, and only the second answers the question. `eprintln!` rather than
+/// `tracing`, because this must reach the console whatever subscriber state
+/// the caller is in.
+#[cfg(target_os = "rtems")]
+pub fn rtems_priority_readback(label: &str, requested_epics: i32, applied: &str) {
+    let mut policy: std::ffi::c_int = -1;
+    let mut param = rtems_sched::SchedParam {
+        sched_priority: -1,
+        sporadic_tail: [0u8; 44],
+    };
+    // SAFETY: both act on the calling thread and write into stack locals of
+    // the target's own width.
+    let (rc, kname) = unsafe {
+        let rc = rtems_sched::pthread_getschedparam(
+            rtems_sched::pthread_self(),
+            &mut policy,
+            &mut param,
+        );
+        let mut buf = [0i8; 32];
+        let nrc = rtems_sched::pthread_getname_np(
+            rtems_sched::pthread_self(),
+            buf.as_mut_ptr() as *mut std::ffi::c_char,
+            buf.len(),
+        );
+        let kname = if nrc == 0 {
+            std::ffi::CStr::from_ptr(buf.as_ptr() as *const std::ffi::c_char)
+                .to_string_lossy()
+                .into_owned()
+        } else {
+            format!("<pthread_getname_np rc={nrc}>")
+        };
+        (rc, kname)
+    };
+    let core = RTEMS_MAXIMUM_PRIORITY - param.sched_priority;
+    eprintln!(
+        "PRIOPROBE label={label} kname={kname} epics={requested_epics} applied={applied} \
+         getsched_rc={rc} policy={policy} posix={} core={core}",
+        param.sched_priority
+    );
+}
