  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "SNAP?5,6,7,8";
    in "%(1:ADC1.VAL)f,%(1:ADC2.VAL)f,%(1:ADC3.VAL)f,%(1:ADC4.VAL)f";
}
