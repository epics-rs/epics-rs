rec0: iSeries.proto RGCmd(1,2,3,4,5,6,7,8,9) P
RGCmd {
  extraInput    = error;
  lockTimeout   = 5000; # ms
  readTimeout   = 400; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "\r";
  outTerminator = "\r";
  separator     = "";

    out "*31";
    in "31%2";
}
