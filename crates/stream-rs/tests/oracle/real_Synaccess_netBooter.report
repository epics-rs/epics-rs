rec3: Synaccess_netBooter.proto get_status5(1,2,3,4,5,6,7,8,9) P
get_status5 {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 100; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "\r\n";
  separator     = "";
  @Mismatch {
    in "%*1c$A5\x0d\x0a%*4c%(12status5.RVAL)1b%(12status4.RVAL)1b%(12status3.RVAL)1b%(12status2.RVAL)1b%(12status1.RVAL)1b";
  }

    out "$A5";
    in "$A5\x0d\x0a%*4c%(12status5.RVAL)1b%(12status4.RVAL)1b%(12status3.RVAL)1b%(12status2.RVAL)1b%(12status1.RVAL)1b";
}
