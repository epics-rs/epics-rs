rec0: MicroE_SS350.proto sync(1,2,3,4,5,6,7,8,9) P
sync {
  extraInput    = ignore;
  lockTimeout   = 5000; # ms
  readTimeout   = 17; # ms
  replyTimeout  = 1000; # ms
  writeTimeout  = 100; # ms
  pollPeriod    = 1000; # ms
  maxInput      = 0; # bytes
  inTerminator  = "";
  outTerminator = "";
  separator     = "";

    out "\x80";
    in "%(1:sync.VAL)1r";
}
